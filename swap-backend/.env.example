# ── DATABASE ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── APP ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# ── GOOGLE OAUTH (optional) ───────────────────────────────
# Get from https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── CLOUDINARY (document uploads) ────────────────────────
# Get from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── EMAIL / SMTP (vaccine reminders) ─────────────────────
# Option A — Gmail with App Password:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your@gmail.com
#   SMTP_PASS=your-app-password   (not your login password)
#
# Option B — Resend (https://resend.com, generous free tier):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxxx
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@swap.pet

# ── RAZORPAY (payments, add later) ───────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
